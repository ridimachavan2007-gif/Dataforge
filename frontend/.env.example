# Copy this file to .env.local and fill in ONE of the two blocks below.
# .env.local is gitignored — never commit real IDs or URLs if this repo
# is public, though the dev token server ID is low-risk (dev-only, rate
# limited by LiveKit).

# ── Option A: LiveKit's hosted dev token server (use this today) ──
VITE_LIVEKIT_TOKEN_SERVER_ID=

# ── Option B: your teammate's real backend endpoint (use this later) ──
# VITE_LIVEKIT_TOKEN_ENDPOINT=
